{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanderai.app/schemas/preferences-export.schema.json",
  "title": "wanderAI Preferences Export",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "exportedAt",
    "preferences"
  ],
  "properties": {
    "format": {
      "const": "wanderAI.preferences"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "preferences": {
      "type": "object",
      "required": [
        "travelerComposition",
        "travelStyle"
      ],
      "properties": {
        "travelerComposition": {
          "type": "object",
          "required": [
            "defaultGroupType"
          ],
          "properties": {
            "defaultGroupType": {
              "type": "string",
              "enum": [
                "solo",
                "couple",
                "family",
                "friends",
                "mixedAgeGroup",
                "other"
              ]
            },
            "adultCount": {
              "type": "integer",
              "minimum": 0
            },
            "childCount": {
              "type": "integer",
              "minimum": 0
            },
            "olderAdultCount": {
              "type": "integer",
              "minimum": 0
            },
            "travelsWithPets": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "travelStyle": {
          "type": "object",
          "required": [
            "pace"
          ],
          "properties": {
            "pace": {
              "type": "string",
              "enum": [
                "relaxed",
                "balanced",
                "active"
              ]
            },
            "spontaneity": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            },
            "preferredDailyStartTime": {
              "type": [
                "string",
                "null"
              ]
            },
            "preferredDailyEndTime": {
              "type": [
                "string",
                "null"
              ]
            },
            "maximumActivitiesPerDay": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilityNeeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "petPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kidPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "olderAdultPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "foodPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drivingPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accommodationPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "destinationPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoidances": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notesForPlanner": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
