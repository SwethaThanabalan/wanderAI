{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanderai.app/schemas/preferences-export.schema.json",
  "title": "wanderAI Preference Export",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "exportedAt", "profile"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["travelStyle", "interests", "budget", "transportation", "audienceNeeds"],
      "properties": {
        "profileName": { "type": "string", "maxLength": 100 },
        "homeRegion": { "type": "string", "maxLength": 200 },
        "units": { "enum": ["imperial", "metric"] },
        "travelStyle": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "pace": { "enum": ["slow", "balanced", "fast"] },
            "planningStyle": { "enum": ["structured", "balanced", "spontaneous"] },
            "preferredStartTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "preferredEndTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "maximumDrivingMinutesPerDay": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "maximumSingleLegMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "restFrequencyMinutes": { "type": "integer", "minimum": 0, "maximum": 600 },
            "prefersScenicRoutes": { "type": "boolean" },
            "avoidNightDriving": { "type": "boolean" },
            "bufferBetweenActivitiesMinutes": { "type": "integer", "minimum": 0, "maximum": 240 }
          }
        },
        "interests": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mustInclude": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
            "niceToHave": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
            "avoid": { "type": "array", "items": { "type": "string", "maxLength": 100 } }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": true,
          "required": ["level"],
          "properties": {
            "level": { "enum": ["budget", "moderate", "comfortable", "luxury", "custom"] },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "dailyTarget": { "type": "number", "minimum": 0 },
            "splurgeCategories": { "type": "array", "items": { "type": "string", "maxLength": 100 } }
          }
        },
        "lodging": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "types": { "type": "array", "items": { "enum": ["hotel", "resort", "vacationRental", "hostel", "camping", "cabin", "other"] } },
            "mustHaveAmenities": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
            "locationPreference": { "type": "array", "items": { "type": "string", "maxLength": 100 } }
          }
        },
        "food": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "dietaryRequirements": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
            "allergies": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
            "preferredCuisines": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
            "dislikedFoods": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
            "mealStyle": { "enum": ["mostlyQuick", "balanced", "experienceFocused"] }
          }
        },
        "transportation": {
          "type": "object",
          "additionalProperties": true,
          "required": ["preferredModes"],
          "properties": {
            "preferredModes": { "type": "array", "items": { "enum": ["driving", "rentalCar", "walking", "cycling", "publicTransit", "rideshare", "ferry", "train", "other"] } },
            "hasOwnVehicle": { "type": "boolean" },
            "needsEVCharging": { "type": "boolean" },
            "avoidFerries": { "type": "boolean" },
            "avoidTolls": { "type": "boolean" },
            "avoidUnpavedRoads": { "type": "boolean" }
          }
        },
        "audienceNeeds": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "defaultAdults": { "type": "integer", "minimum": 0 },
            "childAgeRanges": { "type": "array", "items": { "type": "string", "maxLength": 50 } },
            "olderAdultsIncluded": { "type": "boolean" },
            "dogIncluded": { "type": "boolean" },
            "dog": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "size": { "enum": ["small", "medium", "large", "unknown"] },
                "requiresDogFriendlyLodging": { "type": "boolean" },
                "maximumWalkMinutes": { "type": "integer", "minimum": 0, "maximum": 600 },
                "avoidOffLeashAreas": { "type": "boolean" },
                "notes": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
              }
            },
            "kids": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "strollerNeeded": { "type": "boolean" },
                "carSeatNeeded": { "type": "boolean" },
                "maximumActivityMinutes": { "type": "integer", "minimum": 0, "maximum": 600 },
                "needsFrequentBreaks": { "type": "boolean" }
              }
            },
            "olderAdults": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "avoidSteepInclines": { "type": "boolean" },
                "needsFrequentSeating": { "type": "boolean" },
                "maximumWalkingMinutes": { "type": "integer", "minimum": 0, "maximum": 600 },
                "prioritizeRestrooms": { "type": "boolean" },
                "prioritizeShade": { "type": "boolean" }
              }
            },
            "accessibility": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "wheelchairAccessRequired": { "type": "boolean" },
                "stepFreeRequired": { "type": "boolean" },
                "hearing": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
                "vision": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
                "sensory": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
                "other": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
              }
            }
          }
        },
        "avoidances": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "learnedFeedback": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "liked": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
            "disliked": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
            "notesForPlanner": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containsPreciseLocationHistory": { "const": false },
        "containsAccountIdentifiers": { "const": false },
        "containsPrivateReviewText": { "type": "boolean", "default": false }
      }
    }
  }
}
