{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanderai.app/schemas/trip-import.schema.json",
  "title": "wanderAI Trip Import",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "trip"
  ],
  "properties": {
    "format": {
      "const": "wanderAI.trip"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "trip": {
      "$ref": "#/$defs/trip"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mapReference": {
      "type": "object",
      "required": [
        "latitude",
        "longitude",
        "mapLabel",
        "pinStyle"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "formattedAddress": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapLabel": {
          "type": "string",
          "minLength": 1
        },
        "pinStyle": {
          "type": "string",
          "enum": [
            "start",
            "primary",
            "secondary",
            "end"
          ]
        }
      },
      "additionalProperties": false
    },
    "imageReference": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "asset",
            "remote"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "altText": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "suitabilityItem": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "partial",
            "unknown"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "suitability": {
      "type": "object",
      "properties": {
        "dogFriendly": {
          "$ref": "#/$defs/suitabilityItem"
        },
        "kidFriendly": {
          "$ref": "#/$defs/suitabilityItem"
        },
        "olderAdultFriendly": {
          "$ref": "#/$defs/suitabilityItem"
        },
        "wheelchairAccessible": {
          "$ref": "#/$defs/suitabilityItem"
        },
        "strollerFriendly": {
          "$ref": "#/$defs/suitabilityItem"
        }
      },
      "additionalProperties": false
    },
    "community": {
      "type": "object",
      "properties": {
        "aggregateRating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "reviewCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "popularityLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceLabel": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "id",
        "rating",
        "text",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "authorDisplayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorType": {
          "type": [
            "string",
            "null"
          ]
        },
        "rating": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "visitSeason": {
          "type": [
            "string",
            "null"
          ]
        },
        "helpfulCount": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "enum": [
            "imported",
            "sample"
          ]
        }
      },
      "additionalProperties": false
    },
    "tip": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "authorDisplayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorType": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "visitSeason": {
          "type": [
            "string",
            "null"
          ]
        },
        "helpfulCount": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "required": [
        "id",
        "sequence",
        "name",
        "mapReference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "plannedTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "estimatedDurationMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "history": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapReference": {
          "$ref": "#/$defs/mapReference"
        },
        "heroImage": {
          "anyOf": [
            {
              "$ref": "#/$defs/imageReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "mustDo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suitability": {
          "$ref": "#/$defs/suitability"
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "travelerTips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tip"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "community": {
          "$ref": "#/$defs/community"
        }
      },
      "additionalProperties": false
    },
    "routeHighlight": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "mapReference",
        "optional"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequenceAfterStopId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapReference": {
          "$ref": "#/$defs/mapReference"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/imageReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimatedDetourMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "optional": {
          "type": "boolean"
        },
        "suitability": {
          "$ref": "#/$defs/suitability"
        }
      },
      "additionalProperties": false
    },
    "day": {
      "type": "object",
      "required": [
        "id",
        "dayNumber",
        "title",
        "stops",
        "routeHighlights"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "dayNumber": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "plannedDistanceMiles": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "estimatedDrivingMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stop"
          }
        },
        "routeHighlights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routeHighlight"
          }
        }
      },
      "additionalProperties": false
    },
    "trip": {
      "type": "object",
      "required": [
        "id",
        "name",
        "primaryDestination",
        "days"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "primaryDestination": {
          "type": "string"
        },
        "startDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "endDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "timeZone": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverImage": {
          "anyOf": [
            {
              "$ref": "#/$defs/imageReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "suitability": {
          "$ref": "#/$defs/suitability"
        },
        "plannedDistanceMiles": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/day"
          }
        },
        "community": {
          "$ref": "#/$defs/community"
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
