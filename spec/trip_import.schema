{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanderai.app/schemas/trip-import.schema.json",
  "title": "wanderAI Trip Import",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "trip"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "version": { "type": "string", "maxLength": 50 }
      }
    },
    "trip": { "$ref": "#/$defs/trip" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "minProperties": 1
    },
    "media": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "enum": ["image", "audio"] },
        "url": { "type": "string", "format": "uri" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "caption": { "type": "string", "maxLength": 500 },
        "offlineEligible": { "type": "boolean", "default": true }
      }
    },
    "travelerGroup": {
      "type": "object",
      "additionalProperties": true,
      "required": ["adults"],
      "properties": {
        "adults": { "type": "integer", "minimum": 0, "maximum": 99 },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["age"],
            "properties": {
              "age": { "type": "integer", "minimum": 0, "maximum": 17 },
              "notes": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "olderAdults": { "type": "integer", "minimum": 0, "maximum": 99 },
        "dogs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "maxLength": 100 },
              "size": { "enum": ["small", "medium", "large", "unknown"] },
              "serviceAnimal": { "type": "boolean", "default": false },
              "notes": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "accessibilityNeeds": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
        "sensoryNeeds": { "type": "array", "items": { "type": "string", "maxLength": 100 } }
      }
    },
    "suitabilityDimension": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["suitable", "suitableWithConstraints", "notRecommended", "notAllowed", "unknown"] },
        "recommendedAges": {
          "type": "object",
          "properties": {
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "restrictions": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "sourceLabel": { "type": "string", "maxLength": 200 }
      }
    },
    "suitability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dogs": { "$ref": "#/$defs/suitabilityDimension" },
        "kids": { "$ref": "#/$defs/suitabilityDimension" },
        "olderAdults": { "$ref": "#/$defs/suitabilityDimension" },
        "mobility": { "$ref": "#/$defs/suitabilityDimension" },
        "sensory": { "$ref": "#/$defs/suitabilityDimension" },
        "stroller": { "$ref": "#/$defs/suitabilityDimension" },
        "wheelchair": { "$ref": "#/$defs/suitabilityDimension" }
      }
    },
    "reviewSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["averageRating", "reviewCount"],
      "properties": {
        "averageRating": { "type": "number", "minimum": 0, "maximum": 5 },
        "reviewCount": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "maxLength": 200 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "highlights": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "coordinate", "highlights", "mustDo"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "shortDescription": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 10000 },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "address": { "type": "string", "maxLength": 500 },
        "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "highlights": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "mustDo": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "recommendedVisitMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "activityLevel": { "enum": ["minimal", "easy", "moderate", "strenuous", "unknown"] },
        "suitability": { "$ref": "#/$defs/suitability" },
        "practicalInfo": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "costNote": { "type": "string" },
            "hoursNote": { "type": "string" },
            "reservationNote": { "type": "string" },
            "parkingNote": { "type": "string" },
            "restroomNote": { "type": "string" },
            "foodNote": { "type": "string" },
            "safetyNotes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "reviewSummary": { "$ref": "#/$defs/reviewSummary" },
        "media": { "type": "array", "items": { "$ref": "#/$defs/media" } },
        "sourceUrls": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "routeSpot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "coordinate", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "maxLength": 200 },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "category": { "enum": ["scenic", "audioStory", "food", "restroom", "fuel", "evCharging", "dogBreak", "kidBreak", "accessibility", "emergency", "other"] },
        "description": { "type": "string", "maxLength": 2000 },
        "suggestedStopMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "maximumDetourMinutes": { "type": "integer", "minimum": 0, "maximum": 240 },
        "destinationId": { "$ref": "#/$defs/uuid" },
        "suitability": { "$ref": "#/$defs/suitability" }
      }
    },
    "audioPoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "trigger", "coordinate"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "maxLength": 200 },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "destinationId": { "$ref": "#/$defs/uuid" },
        "itineraryItemId": { "$ref": "#/$defs/uuid" },
        "trigger": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["geofenceEnter", "distance", "routeProgress", "manual", "arrival"] },
            "radiusMeters": { "type": "number", "minimum": 25, "maximum": 5000 },
            "routeProgressMeters": { "type": "number", "minimum": 0 },
            "repeatable": { "type": "boolean", "default": false }
          }
        },
        "audioUrl": { "type": "string", "format": "uri" },
        "transcript": { "type": "string", "maxLength": 50000 },
        "language": { "type": "string", "default": "en" },
        "durationSeconds": { "type": "integer", "minimum": 0 },
        "offlineEligible": { "type": "boolean", "default": true }
      },
      "anyOf": [
        { "required": ["audioUrl"] },
        { "required": ["transcript"] }
      ]
    },
    "itineraryItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "title", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "enum": ["destination", "meal", "lodging", "transport", "activity", "break", "note"] },
        "title": { "type": "string", "maxLength": 200 },
        "destinationId": { "$ref": "#/$defs/uuid" },
        "order": { "type": "integer", "minimum": 0 },
        "startTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "endTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "durationMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "flexible": { "type": "boolean", "default": false },
        "notes": { "type": "string", "maxLength": 5000 },
        "bookingReference": { "type": "string", "maxLength": 500 },
        "routeSpotIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "audioPointIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "date", "title", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 2000 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/itineraryItem" } }
      }
    },
    "trip": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "startDate", "endDate", "timeZone", "travelerGroup", "destinations", "days"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 5000 },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "primaryRegion": { "type": "string", "maxLength": 200 },
        "coverImageUrl": { "type": "string", "format": "uri" },
        "themes": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
        "travelerGroup": { "$ref": "#/$defs/travelerGroup" },
        "destinations": { "type": "array", "items": { "$ref": "#/$defs/destination" } },
        "routeSpots": { "type": "array", "items": { "$ref": "#/$defs/routeSpot" } },
        "audioPoints": { "type": "array", "items": { "$ref": "#/$defs/audioPoint" } },
        "days": { "type": "array", "items": { "$ref": "#/$defs/day" } },
        "importantNotes": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
        "emergencyInfo": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "localEmergencyNumber": { "type": "string", "maxLength": 50 },
            "notes": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
          }
        }
      }
    }
  }
}
